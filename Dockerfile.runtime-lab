ARG BASE
FROM ${BASE}
# Prepare signed dependencies before the real test runs with --network none.
RUN dnf -y --setopt=gpgcheck=1 install python3-requests python3-filelock python3-psutil python3-iniconfig python3-jinja2 openssl \
    && mkdir /lab-fixture \
    && dnf download --destdir /lab-fixture dovecot-2.3.21-19.el10_2.8.x86_64 dovecot-pigeonhole-2.3.21-19.el10_2.8.x86_64 \
    && printf '%s\n' \
       'a0da375d5feaa8e62fd5caa6c49ff31d8a9ec152014af79e0412913d678dc211  /lab-fixture/dovecot-2.3.21-19.el10_2.8.x86_64.rpm' \
       'ad5c2245da1c84fef4a623d2a646adae50ab0bac6fe7e3849993cfa2d5ba67a4  /lab-fixture/dovecot-pigeonhole-2.3.21-19.el10_2.8.x86_64.rpm' | sha256sum -c - \
    && rpmkeys --checksig /lab-fixture/*.rpm \
    && dnf -y --setopt=gpgcheck=1 --setopt=localpkg_gpgcheck=1 install /lab-fixture/*.rpm \
    && groupadd -g 5000 vmail \
    && useradd -u 5000 -g 5000 -M -s /sbin/nologin vmail \
    && dnf -y clean all
ENV CHATMAIL_ISOLATED_LAB=1 PYTHONDONTWRITEBYTECODE=1 RELAY_SOURCE=/relay
ENTRYPOINT ["python3", "/project/tests/integration_runtime24.py"]
